# Copy this file to ".env" in this same folder and fill in real values.
# ".env" is gitignored — never commit real secrets.

# MySQL connection
DB_URL=jdbc:mysql://localhost:3306/totp_auth
DB_USERNAME=root
DB_PASSWORD=change-me

# Must be EXACTLY the same value as auth-service's AES_SECRET_KEY —
# user-service encrypts the TOTP secret, auth-service decrypts it.
# Generate a real 32-byte key with: openssl rand -base64 32
AES_SECRET_KEY=change-me-32-byte-base64-key

# Shared secret that only auth-service should know. Sent as the
# X-Internal-Api-Key header on every call from auth-service to user-service.
# Generate with: openssl rand -base64 32
INTERNAL_API_KEY=change-me-shared-secret
