# Copy this file to ".env" in this same folder and fill in real values.
# ".env" is gitignored — never commit real secrets.

# Signing key for issued JWTs. Generate with: openssl rand -base64 64
JWT_SECRET=change-me-long-random-string

# Must be EXACTLY the same value as user-service's AES_SECRET_KEY —
# auth-service decrypts the TOTP secret that user-service encrypted.
# Generate a real 32-byte key with: openssl rand -base64 32
AES_SECRET_KEY=change-me-32-byte-base64-key

# Must be EXACTLY the same value as user-service's INTERNAL_API_KEY.
# Generate with: openssl rand -base64 32
INTERNAL_API_KEY=change-me-shared-secret

# Where user-service is reachable
USER_SERVICE_BASE_URL=http://localhost:8081/users/
